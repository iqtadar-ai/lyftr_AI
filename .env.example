# Comma-separated pool of API keys tried in order (Groq gsk_... and Gemini AIza.../AQ.... supported)
LLM_API_KEYS=gsk_your_primary_groq_key,gsk_your_backup_groq_key,AIza_your_gemini_fallback_key

# Provider-specific models
GROQ_MODEL=groq/openai/gpt-oss-20b
GEMINI_MODEL=gemini/gemini-3.8-flash

# Enable X-Simulate-Failure header for testing failover (set false in production)
ENABLE_FAILURE_SIMULATION=true

# SQLite database URL (Docker Compose overrides this to sqlite:////data/app.db)
DATABASE_URL=sqlite:///./app.db

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Frontend API target
VITE_API_BASE_URL=http://localhost:8000